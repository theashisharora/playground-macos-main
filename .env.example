# Copy to .env.local for local development. Both values are PUBLIC and end up
# in the browser bundle: never put API keys, passwords or your inbox address here.

# URL of the deployed contact Worker (no trailing slash). Leave empty for preview mode.
VITE_CONTACT_ENDPOINT=

# Cloudflare Turnstile *site* key (public). Leave empty in local preview mode.
VITE_TURNSTILE_SITE_KEY=

# Independent classic portfolio for initial viewports below 768 CSS pixels.
# HTTPS URL; this does not change hosting or domain assignments.
VITE_CLASSIC_PORTFOLIO_URL=https://ashisharora.vercel.app/
